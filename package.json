{
  "name": "south-india-coffee-shop",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @south-india-coffee-shop/api",
    "dev:web": "npm run dev --workspace @south-india-coffee-shop/web",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow",
    "test:a11y": "npm run test:a11y --workspace @south-india-coffee-shop/web",
    "seed": "npm run seed --workspace @south-india-coffee-shop/api",
    "seed:catalog": "npm run seed:catalog --workspace @south-india-coffee-shop/api",
    "seed:admin": "npm run seed:admin --workspace @south-india-coffee-shop/api",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
