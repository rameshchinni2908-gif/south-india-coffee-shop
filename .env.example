NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/south-india-coffee-shop
# Optional workaround when the local DNS provider blocks Atlas SRV lookups.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_EXPIRES_IN=15m
CLIENT_URL=http://localhost:5173
SHOP_TIMEZONE=Asia/Kolkata
TAX_PERCENTAGE=0
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

VITE_API_BASE_URL=http://localhost:4000
VITE_SHOP_NAME=South India Coffee Shop
