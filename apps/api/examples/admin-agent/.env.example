# Copy to .env in this directory. Real credentials belong only in that ignored file.
# Existing Node API origin (no /api suffix). HTTPS required except localhost.
SHOP_API_URL=http://localhost:4000
SHOP_ADMIN_EMAIL=
SHOP_ADMIN_PASSWORD=

# Only required for AI briefing; --inspect works without an OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
