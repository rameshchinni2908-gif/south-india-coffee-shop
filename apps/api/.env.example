NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/south-india-coffee-shop
# Optional workaround when the local DNS provider blocks Atlas SRV lookups.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_EXPIRES_IN=15m
CLIENT_URL=http://localhost:5173
SHOP_TIMEZONE=Asia/Kolkata
TAX_PERCENTAGE=0
# Optional server-only shop assistant. Without a key, the rest of the app works normally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Hybrid knowledge retrieval (uses OPENAI_API_KEY; keyword-only without it).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
# memory: any MongoDB. atlas: Atlas Vector Search after `npm run knowledge:index`.
KNOWLEDGE_VECTOR_SEARCH=memory
# Public "Order by message" on the menu. Spends API credits; capped per shop day.
ORDER_ASSISTANT_ENABLED=false
ORDER_ASSISTANT_DAILY_LIMIT=300
# Optional: lets the "Morning prep brief" GitHub Actions workflow prepare the plan at 06:00.
PREP_BRIEF_CRON_TOKEN=
# Optional remote MCP endpoint. Use a random 32+ character token to enable it.
MCP_SERVER_TOKEN=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Kaapi Karts mini-game. Ships disabled; see KAAPI-KARTS.md.
GAME_ENABLED=false
GAME_ROOM_TTL_MINUTES=60
GAME_RESULT_TTL_HOURS=24
GAME_MAX_ROOMS_PER_IP_PER_HOUR=10
