NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/south-india-coffee-shop
# Optional workaround when the local DNS provider blocks Atlas SRV lookups.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
CLIENT_URL=http://localhost:5173
SHOP_TIMEZONE=Asia/Kolkata
TAX_PERCENTAGE=0
